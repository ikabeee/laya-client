# Copy to .env and adjust. Every variable is optional; the defaults are shown.

# --- Server -----------------------------------------------------------------
LAYA_HOST=0.0.0.0
LAYA_PORT=8000
LAYA_LOG_LEVEL=info
# Public URL prefix when a reverse proxy serves the API under a path (e.g. /laya).
LAYA_ROOT_PATH=
# Comma-separated origins allowed to call the API from a browser. Empty disables CORS.
LAYA_CORS_ORIGINS=
# Serve the Scalar API reference at /docs and the spec at /openapi.json.
LAYA_DOCS_ENABLED=true

# --- Security ---------------------------------------------------------------
# Comma-separated bearer tokens. When set, clients send `Authorization: Bearer <key>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LAYA_API_KEY=

# --- Engine -----------------------------------------------------------------
# laya = real model (needs laya-client[engine]); mock = deterministic answers, no model.
LAYA_ENGINE=laya
# cpu | cuda | mps. Empty lets Laya choose.
LAYA_DEVICE=
# Load checkpoints at startup (in the background; /ready turns 200 when done).
LAYA_PRELOAD=true
# Checkpoints to preload: english, multilingual, typed-decisions. Empty = all three.
LAYA_MODELS=english,multilingual
# Cap torch threads on CPU. Keep at or below the number of physical cores.
LAYA_THREADS=
# Fallback checkpoint for states with no language evidence (set multilingual for mostly non-English traffic).
LAYA_DEFAULT_MODEL=
# Checkpoints resident at once (Laya default 2; set 3 with LAYA_AUTO_TASK=true).
LAYA_MAX_LOADED=
LAYA_AUTO_TASK=false
# Reply with the strict Jev contract only (no routing, no answer_confidence, usage = 2 counts).
LAYA_JEV_STRICT=false

# --- Limits -----------------------------------------------------------------
LAYA_MAX_CONCURRENT=16
LAYA_MAX_BODY_BYTES=2097152
LAYA_MAX_QUESTIONS=64
LAYA_MAX_STATE_CHARS=50000
LAYA_MAX_BATCH_STATES=64
LAYA_MAX_CHOICE_OPTIONS=100
LAYA_MAX_SCORE_LEVELS=32
LAYA_MAX_TOTAL_OPTIONS=512
LAYA_MAX_TOKEN_BUDGET=8192
LAYA_MAX_BATCH_TOKENS=131072
